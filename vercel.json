    },
    {
      "source": "/DiscountFirst",
      "destination": "/discount-first.html"
    },
    {
      "source": "/DISCOUNTFIRST",
      "destination": "/discount-first.html"
    },
    {
      "source": "/discount-first",
      "destination": "/discount-first.html"
    },
    {
      "source": "/sponsorships",
      "destination": "/sponsor.html"
    },
    {
      "source": "/Sponsorships",
      "destination": "/sponsor.html"
    },
    {
      "source": "/SPONSORSHIPS",
      "destination": "/sponsor.html"
    },
    {
      "source": "/sponsorship",
      "destination": "/sponsor.html"
    },
    {
      "source": "/sponsor",
      "destination": "/sponsor.html"
    }
  ]
